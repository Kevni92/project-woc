{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visualVersion",
    "worldId",
    "worldVersion",
    "buildings",
    "roads",
    "surfaces",
    "coasts",
    "decorations"
  ],
  "properties": {
    "visualVersion": {
      "const": 2
    },
    "worldId": {
      "$ref": "#/definitions/id"
    },
    "worldVersion": {
      "const": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "buildingId",
          "profile"
        ],
        "properties": {
          "buildingId": {
            "$ref": "#/definitions/id"
          },
          "profile": {
            "enum": [
              "residential",
              "commercial",
              "warehouse"
            ]
          },
          "roof": {
            "enum": [
              "flat",
              "gabled"
            ]
          },
          "roofHeightM": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "windows": {
            "enum": [
              "none",
              "subtle",
              "bands"
            ]
          }
        }
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roadId",
          "profile",
          "polygon"
        ],
        "properties": {
          "roadId": {
            "$ref": "#/definitions/id"
          },
          "profile": {
            "enum": [
              "main",
              "local"
            ]
          },
          "markings": {
            "enum": [
              "none",
              "center"
            ]
          },
          "sidewalkWidthM": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "polygon": {
            "$ref": "#/definitions/area"
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "polygon"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "kind": {
            "enum": [
              "parcel",
              "grass",
              "plaza",
              "promenade",
              "beach"
            ]
          },
          "polygon": {
            "$ref": "#/definitions/area"
          }
        }
      }
    },
    "coasts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/definitions/point"
            }
          },
          "kind": {
            "enum": [
              "shore",
              "island",
              "cut"
            ]
          }
        }
      }
    },
    "decorations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "polygon",
          "elevationM"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "kind": {
            "const": "pier"
          },
          "polygon": {
            "$ref": "#/definitions/ring"
          },
          "elevationM": {
            "type": "number",
            "minimum": 0.75,
            "maximum": 15
          }
        }
      },
      "maxItems": 0
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      },
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/definitions/point"
      }
    },
    "area": {
      "type": "object",
      "required": [
        "polygons"
      ],
      "additionalProperties": false,
      "properties": {
        "polygons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "outer",
              "holes"
            ],
            "additionalProperties": false,
            "properties": {
              "outer": {
                "$ref": "#/definitions/ring"
              },
              "holes": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ring"
                }
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
