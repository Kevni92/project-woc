{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:woc:client:v1",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "Hello"
        },
        "requestId": {
          "$ref": "#/definitions/id"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "SnapshotRequest"
        },
        "requestId": {
          "$ref": "#/definitions/id"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "Command"
        },
        "requestId": {
          "$ref": "#/definitions/id"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "characterId"
          ],
          "properties": {
            "action": {
              "enum": [
                "AcquireCharacter",
                "ReleaseCharacter",
                "TestAction"
              ]
            },
            "characterId": {
              "$ref": "#/definitions/id"
            }
          }
        }
      }
    }
  ]
}
